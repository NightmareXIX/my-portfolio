# ─────────────────────────────────────────────────────────────
#  TEMPLATE — safe to commit. Copy to .env.local and fill in.
#      cp .env.example .env.local
#  Never put real values in THIS file.
# ─────────────────────────────────────────────────────────────

# ── 1. Gemini (required) ─────────────────────────────────────
# aistudio.google.com/apikey → "Create API key"
# Starts with "AIza", ~39 characters.
GEMINI_API_KEY=

# VERIFIED against your account's quota page.
# gemini-3.5-flash-lite = 15 RPM / 250K TPM / 500 requests-per-day.
# Do NOT switch to a non-Lite Flash model: those are capped at 20 RPD,
# which a single visitor could exhaust in one conversation.
GEMINI_MODEL=gemini-3.5-flash-lite


# ── 2. Upstash Redis (required) ──────────────────────────────
# console.upstash.com → your database → "REST API" tab
# URL looks like https://xxxx-yyyy-12345.upstash.io
UPSTASH_REDIS_REST_URL=
# Token is a long base64-ish string. Use the READ-WRITE token, not read-only.
UPSTASH_REDIS_REST_TOKEN=



# ── 3. App secret (required) ─────────────────────────────────
# Salt for hashing visitor IPs so raw IPs are never stored.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=


# ── 4. Groq failover (optional) ──────────────────────────────
# console.groq.com/keys — used when Gemini returns 429 / 5xx.
# STRONGLY RECOMMENDED now: Gemini free tier is only 500 requests/day, so
# Groq is what keeps the bot alive on a traffic spike. Blank = canned fallback.
GROQ_API_KEY=
# VERIFIED against your key: 1000 requests/day (2x Gemini's 500).
# Alternatives on your account: openai/gpt-oss-120b (higher quality,
# slower), qwen/qwen3.8-27b. llama-3.3-70b is NOT available to you.
GROQ_MODEL=openai/gpt-oss-20b


# ── 5. Behaviour knobs (have working defaults) ───────────────
# Kill switch. "false" disables the chatbot instantly with no redeploy.
CHATBOT_ENABLED=true

# Personality intensity: mild | medium | unhinged
GLAZE_LEVEL=medium

# Site-wide daily call ceiling. Sits BELOW Gemini's 500 RPD free-tier quota
# so you degrade into canned answers instead of taking a 429 from Google.
GLOBAL_DAILY_CAP=450

# Groq's own daily ceiling, used once the Gemini leg trips its cap.
# VERIFIED against your key: 1000 requests/day. Combined ceiling: 1450/day.
GROQ_DAILY_CAP=1000

# Comma-separated origin allowlist. Add your production domain before deploy.
# Production MUST list the live domain or every chat request 403s (see lib/bot/integrity.ts).
# Vercel preview deploys get random *.vercel.app hostnames and are NOT covered — add one
# explicitly if you need the bot working on a preview.
ALLOWED_ORIGINS=https://fardinislamsadnan.vercel.app,http://localhost:3005


# ── 6. Cloudflare Turnstile (optional, off by default) ───────
# Only fill these in if you actually see bot abuse. Both must be set to activate.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
